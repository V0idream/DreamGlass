<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      LibXposed 模块的模块身份声明（实证来源）：
      - 入口类注册：src/main/resources/META-INF/xposed/java_init.list
      - 模块元信息：src/main/resources/META-INF/xposed/module.prop（minApiVersion/targetApiVersion）
      - 注入作用域：src/main/resources/META-INF/xposed/scope.list
        （com.android.systemui、com.android.launcher；以 scope.list 为准）
      见 api 源码 package-info.java 的 "Entry Registration / Module Configuration / Scope" 章节。
      与同类 Xposed 模块（META-INF/xposed 三件套）做法一致。

      android:label / android:description 会被框架作为模块名与描述读取（ApplicationInfo）。
      LSPosed 兼容：设置入口 Activity 声明
      category=de.robv.android.xposed.category.MODULE_SETTINGS（反编译实证）。
      未加 xposedmodule meta-data（新式 LibXposed 框架不依赖它，见 package-info.java）。
    -->

    <!-- DreamGlass 不联网；参考项目的自动升级入口不再调用。 -->

    <!-- 包可见性声明（hook 安装分发与设置页读取宿主信息用） -->
    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.android.launcher" />
        <package android:name="com.coloros.gallery3d" />
        <package android:name="com.coloros.calculator" />
        <package android:name="com.coloros.smartsidebar" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LiquidGlass"
        android:supportsRtl="true">

        <activity android:name=".ui.DreamActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias android:name="${applicationId}.LauncherAlias"
            android:targetActivity=".ui.DreamActivity" android:enabled="true" android:exported="true"
            android:label="@string/app_name" android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".ui.LicenseActivity" android:exported="false" />
        <!-- 完整高级配置。 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false">
        </activity>

        <!-- 日志文件分享通道：设置页分享抓取文件（captures/）走 content uri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".log.LogProvider"
            android:authorities="${applicationId}.lgfile"
            android:exported="true" />

        <!-- 日志文件分享通道：设置页「分享日志」把 lg.log 变成可分享的 content uri -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
