<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchTextContrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_text_contrast" android:fontFamily="sans-serif-medium" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" android:layout_marginTop="0dp" />
            <TextView android:id="@+id/textContrastDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_text_contrast_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchQsIconContrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_qs_icon_contrast" android:textColor="@color/dream_ink" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_qs_icon_contrast_desc" android:textColor="@color/dream_muted" android:textSize="13sp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchHeadsUpTextFollow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/settings_heads_up_text_follow" android:fontFamily="sans-serif-medium" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:id="@+id/headsUpTextFollowDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_heads_up_text_follow_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/textForceRefreshLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/settings_text_force_refresh_interval" android:textAppearance="?attr/textAppearanceTitleSmall" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:textColor="@color/dream_ink" android:textSize="15sp" />
            <SeekBar android:id="@+id/seekTextForceRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="5000" android:progress="500" android:thumbTint="@color/dream_accent" android:progressTint="@color/dream_accent" android:progressBackgroundTint="@color/dream_line" android:minHeight="44dp" />
            <TextView android:id="@+id/textForceRefreshValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:background="@drawable/dream_value_background" android:textColor="@color/dream_accent" android:gravity="end" android:textSize="12sp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/textForceRefreshDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_text_force_refresh_interval_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
    </LinearLayout>
</ScrollView>