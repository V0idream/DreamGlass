<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <Switch android:id="@+id/switchGalleryGlass" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/settings_gallery_glass"
                android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/settings_gallery_glass_desc" android:textColor="@color/dream_muted"
                android:textSize="13sp" />
        </com.coloros16.liquidglass.ui.ParameterCard>

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <Switch android:id="@+id/switchSmartSidebarGlass" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/settings_smart_sidebar_glass"
                android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/settings_smart_sidebar_glass_desc" android:textColor="@color/dream_muted"
                android:textSize="13sp" />
        </com.coloros16.liquidglass.ui.ParameterCard>

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <Switch android:id="@+id/switchAssistantScreenGlass" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/settings_assistant_screen_glass"
                android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/settings_assistant_screen_glass_desc" android:textColor="@color/dream_muted"
                android:textSize="13sp" />
        </com.coloros16.liquidglass.ui.ParameterCard>

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp">
            <Switch android:id="@+id/switchNotificationPopupGlass" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/settings_notification_popup_glass"
                android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/settings_notification_popup_glass_desc" android:textColor="@color/dream_muted"
                android:textSize="13sp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
    </LinearLayout>
</ScrollView>
