<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchEnableLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_enable_logs" android:fontFamily="sans-serif-medium" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" android:layout_marginTop="0dp" />
            <TextView android:id="@+id/enableLogsDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_enable_logs_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/shareLogRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="?attr/selectableItemBackground" android:padding="12dp" android:text="@string/settings_share_log" android:textAppearance="?attr/textAppearanceBodyMedium" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:textColor="@color/dream_muted" />
            <TextView android:id="@+id/logDiagRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackground" android:padding="12dp" android:text="@string/settings_log_diag" android:textAppearance="?attr/textAppearanceBodySmall" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:textColor="@color/dream_muted" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_dump_original_note" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
    </LinearLayout>
</ScrollView>