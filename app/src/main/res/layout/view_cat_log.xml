<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"><Switch android:id="@+id/switchEnableLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_enable_logs" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />

        <TextView android:id="@+id/enableLogsDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_enable_logs_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" />

        </com.coloros16.liquidglass.ui.ParameterCard><com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"><Switch android:id="@+id/switchCaptureAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_capture_include_all" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />

        <TextView android:id="@+id/captureStartRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="?attr/selectableItemBackground" android:padding="12dp" android:text="@string/settings_capture_start" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/dream_muted" />

        <TextView android:id="@+id/captureStopRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="?attr/selectableItemBackground" android:padding="12dp" android:text="@string/settings_capture_stop" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/dream_muted" />

        </com.coloros16.liquidglass.ui.ParameterCard><TextView android:id="@+id/captureStatusRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:padding="12dp" android:text="@string/settings_capture_idle" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout android:id="@+id/captureList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_dump_original_note" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?android:attr/textColorSecondary" />


    </LinearLayout>
</ScrollView>