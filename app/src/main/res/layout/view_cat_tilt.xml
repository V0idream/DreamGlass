<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
        <Switch android:id="@+id/switchNotificationDissolve" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/settings_notification_dissolve" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_notification_dissolve_desc"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/settings_notification_dissolve_speed" android:textColor="@color/dream_ink" android:textSize="14sp" />
        <SeekBar android:id="@+id/seekNotificationDissolveSpeed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="265" android:progress="65" />
        <TextView android:id="@+id/notificationDissolveSpeedValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="20dp"
            android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" />


</com.coloros16.liquidglass.ui.ParameterCard>

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchRecentsDissolve" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_recents_dissolve" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_recents_dissolve_desc" android:textColor="@color/dream_muted" android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settings_recents_dissolve_speed" android:textColor="@color/dream_ink" android:textSize="14sp" />
            <SeekBar android:id="@+id/seekRecentsDissolveSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="265" android:progress="65" />
            <TextView android:id="@+id/recentsDissolveSpeedValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dream_muted" android:textAppearance="?attr/textAppearanceBodySmall" />
        </com.coloros16.liquidglass.ui.ParameterCard>

        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchAnimTilt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_anim_tilt_enabled" android:fontFamily="sans-serif-medium" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" android:layout_marginTop="0dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_anim_tilt_strength" android:textAppearance="?attr/textAppearanceTitleSmall" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:textColor="@color/dream_ink" android:textSize="15sp" />
            <SeekBar android:id="@+id/seekAnimTiltStrength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="200" android:progress="100" android:thumbTint="@color/dream_accent" android:progressTint="@color/dream_accent" android:progressBackgroundTint="@color/dream_line" android:minHeight="44dp" />
            <TextView android:id="@+id/animTiltStrengthValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_accent" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:background="@drawable/dream_value_background" android:gravity="end" android:textSize="12sp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_strength_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_anim_tilt_perspective" android:textAppearance="?attr/textAppearanceTitleSmall" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:textColor="@color/dream_ink" android:textSize="15sp" />
            <SeekBar android:id="@+id/seekAnimTiltPerspective" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="150" android:progress="100" android:thumbTint="@color/dream_accent" android:progressTint="@color/dream_accent" android:progressBackgroundTint="@color/dream_line" android:minHeight="44dp" />
            <TextView android:id="@+id/animTiltPerspectiveValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_accent" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:background="@drawable/dream_value_background" android:gravity="end" android:textSize="12sp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_anim_tilt_perspective_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/settings_anim_tilt_restart_note" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <Switch android:id="@+id/switchNotifTilt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/settings_notif_tilt_enabled" android:fontFamily="sans-serif-medium" android:textColor="@color/dream_ink" android:textSize="15sp" android:minHeight="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_notif_tilt_enabled_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_notif_tilt_strength" android:textAppearance="?attr/textAppearanceTitleSmall" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:textColor="@color/dream_ink" android:textSize="15sp" />
            <SeekBar android:id="@+id/seekNotifTiltStrength" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="45" android:progress="3" android:thumbTint="@color/dream_accent" android:progressTint="@color/dream_accent" android:progressBackgroundTint="@color/dream_line" android:minHeight="44dp" />
            <TextView android:id="@+id/notifTiltStrengthValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_accent" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:background="@drawable/dream_value_background" android:gravity="end" android:textSize="12sp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/settings_notif_fly_scale" android:textAppearance="?attr/textAppearanceTitleSmall" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="3dp" android:textColor="@color/dream_ink" android:textSize="15sp" />
            <SeekBar android:id="@+id/seekNotifFlyScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="80" android:progress="75" android:thumbTint="@color/dream_accent" android:progressTint="@color/dream_accent" android:progressBackgroundTint="@color/dream_line" android:minHeight="44dp" />
            <TextView android:id="@+id/notifFlyScaleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_accent" android:fontFamily="monospace" android:lineSpacingExtra="3dp" android:background="@drawable/dream_value_background" android:gravity="end" android:textSize="12sp" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/settings_notif_tilt_strength_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/dream_muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" />
        </com.coloros16.liquidglass.ui.ParameterCard>
    </LinearLayout>
</ScrollView>