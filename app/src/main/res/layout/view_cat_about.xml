<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.coloros16.liquidglass.ui.ParameterCard android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DreamGlass" android:textSize="25sp" android:textColor="@color/dream_ink" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="For ColorOS 17" android:textColor="@color/dream_accent" />
            <Button android:id="@+id/aboutOpenLegal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="开源许可与项目来源" />
            <Button android:id="@+id/aboutOpenSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DreamGlass 项目主页" />
