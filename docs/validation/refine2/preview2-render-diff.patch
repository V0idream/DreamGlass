diff --git a/app/src/main/kotlin/com/coloros16/liquidglass/hook/QsSeekbarCompat.kt b/app/src/main/kotlin/com/coloros16/liquidglass/hook/QsSeekbarCompat.kt
new file mode 100644
index 0000000..25eb3b8
--- /dev/null
+++ b/app/src/main/kotlin/com/coloros16/liquidglass/hook/QsSeekbarCompat.kt
@@ -0,0 +1,41 @@
+package com.coloros16.liquidglass.hook
+
+import android.graphics.Rect
+import android.view.View
+import java.lang.reflect.Method
+import java.util.Collections
+import java.util.WeakHashMap
+
+/** Factory signatures and the wrapper -> actual rendering-object relationship are separate contracts. */
+class QsSeekbarCompat {
+    private val activeWrappers = Collections.synchronizedMap(WeakHashMap<Any, Boolean>())
+    private val activeTargets = Collections.synchronizedMap(WeakHashMap<Any, Boolean>())
+
+    fun resolveActiveFactory(type: Class<*>): Method {
+        val name = "getSeekBarActiveDrawable"
+        return try {
+            // SystemUI 17.99.02. Do not select unrelated overloads by name/argument count.
+            type.getDeclaredMethod(name, View::class.java, Rect::class.java,
+                Float::class.javaPrimitiveType!!, Float::class.javaPrimitiveType!!,
+                Boolean::class.javaPrimitiveType!!, Boolean::class.javaPrimitiveType!!,
+                Float::class.javaPrimitiveType!!)
+        } catch (_: NoSuchMethodException) {
+            type.getDeclaredMethod(name, View::class.java)
+        }
+    }
+
+    fun registerFactoryResult(wrapper: Any?) {
+        if (wrapper != null) activeWrappers[wrapper] = true
+    }
+
+    fun isActiveWrapper(wrapper: Any): Boolean = activeWrappers.containsKey(wrapper)
+
+    /** Called during AutoBlurDrawable mapping, after PlatformBlurDrawable has a real inner target. */
+    fun bind(wrapper: Any, target: Any): Boolean {
+        if (!activeWrappers.containsKey(wrapper)) return false
+        activeTargets[target] = true
+        return true
+    }
+
+    fun isActiveTarget(target: Any): Boolean = activeTargets.containsKey(target)
+}
diff --git a/app/src/main/kotlin/com/coloros16/liquidglass/hook/VolumeMaskGuard.kt b/app/src/main/kotlin/com/coloros16/liquidglass/hook/VolumeMaskGuard.kt
new file mode 100644
index 0000000..b8c57ee
--- /dev/null
+++ b/app/src/main/kotlin/com/coloros16/liquidglass/hook/VolumeMaskGuard.kt
@@ -0,0 +1,43 @@
+package com.coloros16.liquidglass.hook
+
+import android.view.View
+import java.lang.reflect.Modifier
+import java.util.Collections
+import java.util.WeakHashMap
+
+/** Preserve the volume window's mask without changing Preview2's glass rendering path. */
+object VolumeMaskGuard {
+    private val decisions = Collections.synchronizedMap(WeakHashMap<Any, Boolean>())
+
+    fun isVolumeClass(name: String): Boolean = name.startsWith("com.oplus.systemui.volume.") ||
+        name.startsWith("com.android.systemui.volume.")
+
+    fun preserveMask(wrapper: Any): Boolean {
+        decisions[wrapper]?.let { return it }
+        val result = try {
+            val supplier = wrapper.javaClass.getDeclaredField("getHostViewName")
+                .apply { isAccessible = true }.get(wrapper)
+            // COS17's callback captures PlatformBlurHelper, which owns the actual host View.
+            // Resource IDs and shared SurfaceControl layer descriptions are not scene evidence.
+            val host = supplier?.javaClass?.declaredFields?.asSequence()
+                ?.filter { !Modifier.isStatic(it.modifiers) }
+                ?.mapNotNull { field ->
+                    try {
+                        val owner = field.apply { isAccessible = true }.get(supplier)
+                        if (owner is View) owner else owner?.javaClass?.getDeclaredField("hostView")
+                            ?.apply { isAccessible = true }?.get(owner) as? View
+                    } catch (_: Throwable) { null }
+                }?.firstOrNull()
+            var cursor = host
+            var volume = false
+            for (i in 0 until 10) {
+                val view = cursor ?: break
+                if (isVolumeClass(view.javaClass.name)) { volume = true; break }
+                cursor = view.parent as? View
+            }
+            volume
+        } catch (_: Throwable) { false }
+        decisions[wrapper] = result
+        return result
+    }
+}
